.venv
.idea
.env

# Ignore all parquet & csv files in data folder
data/**/*.parquet
data/**/*.csv

# Keep the folder structure
!data/**/
!data/**/.gitkeep


!artifacts/**/.gitkeep


artifacts/**/*.joblib
artifacts/**/*.onnx


artifacts/offline/evaluation/*.csv
artifacts/offline/evaluation/*.json
artifacts/offline/evaluation/*.parquet

artifacts/offline/models/*.csv
artifacts/offline/preprocessing/*.joblib


artifacts/streaming/checkpoints/*
artifacts/streaming/online/*
artifacts/tmp_tests/*


docs/papers/*
docs/references/*

logs/*
!logs/**/.gitkeep

ops/airflow



scripts/**/__pycache__
src/**/__pycache__
tests/**/__pycache__

